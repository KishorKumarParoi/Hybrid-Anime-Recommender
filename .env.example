# ==============================================================================
# HYBRID ANIME RECOMMENDER & AI AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Comet ML Experiment Tracking
# ------------------------------------------------------------------------------
# Get your API key from https://www.comet.com
COMET_API_KEY="your-comet-ml-api-key"
COMET_PROJECT_NAME="hybrid-anime-recommender"
COMET_WORKSPACE="your-comet-workspace"

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT="your-gcp-project-id"
GCP_REGION="us-central1"
# Relative or absolute path to your GCP Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account-key.json"

# ------------------------------------------------------------------------------
# 3. Google Cloud Storage (GCS) Buckets
# ------------------------------------------------------------------------------
# Primary raw dataset storage bucket (e.g., anime-recommender-<PROJECT_ID>)
BUCKET_NAME="anime-recommender-your-gcp-project-id"
GCS_BUCKET_URI="gs://anime-recommender-your-gcp-project-id"
GCS_PUBLIC_URL="https://storage.googleapis.com/anime-recommender-your-gcp-project-id"

# Dedicated DVC version tracking bucket (e.g., anime-recommender-dvc-<PROJECT_ID>)
DVC_BUCKET_NAME="anime-recommender-dvc-your-gcp-project-id"
DVC_REMOTE_URL="gs://anime-recommender-dvc-your-gcp-project-id/dvc_store"

# ------------------------------------------------------------------------------
# 4. GCP Service Account Details
# ------------------------------------------------------------------------------
SA_NAME="anime-recommender"
SA_EMAIL="anime-recommender@your-gcp-project-id.iam.gserviceaccount.com"

# ------------------------------------------------------------------------------
# 5. AI Anime Agent (Groq LLM / Llama 3.1)
# ------------------------------------------------------------------------------
# Optional: Free API key from https://console.groq.com to enable conversational reasoning
GROQ_API_KEY="your-groq-api-key-here"

# ------------------------------------------------------------------------------
# 6. Container Registry (GCR) Configuration
# ------------------------------------------------------------------------------
GCR_HOSTNAME="gcr.io"
GCR_IMAGE_NAME="gcr.io/your-gcp-project-id/hybrid-anime-recommender"
