# ==============================================================================
# NVIDIA TRITON INFERENCE SERVER - MODEL CONFIGURATION
# ==============================================================================
name: "hybrid_recommender_net"
platform: "pytorch_libtorch"
max_batch_size: 128

input [
  {
    name: "user_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "anime_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "prediction_scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 5000
}
