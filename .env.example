# ==============================================================================
# HYBRID ANIME RECOMMENDER & AI AGENT - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# DO NOT COMMIT YOUR REAL .env FILE TO GIT. It is already in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Providers & Observability (LangSmith / LangChain)
# ------------------------------------------------------------------------------
# LangSmith / LangChain tracing and evaluation (LLM-as-a-Judge)
# Get your API key from https://smith.langchain.com
LANGSMITH_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
# Set to "true" after adding your LANGSMITH_API_KEY below to enable live tracing
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="hybrid-anime-recommender"
LANGSMITH_DATASET="anime-research-reports"

# Groq Cloud API Key (High-Speed Llama 3.1 Inference)
# Get your free key from https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"

# OpenAI API Key (GPT-4o fallback, embeddings, and PyRIT attacker model)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"

# Anthropic API Key (Optional alternative evaluator or red team model)
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_here"

# TensorZero Model Gateway Sidecar
TENSORZERO_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. PyRIT 0.14.0 & Adversarial Red Teaming Configuration
# ------------------------------------------------------------------------------
# Target API URL that PyRIT attacks will run against
TARGET_URL="http://localhost:5001"
PYRIT_DASHBOARD_PORT=8001

# Microsoft PyRIT native Azure OpenAI credentials (optional if using OpenAI or local)
# Required if using Azure OpenAI as the attacker model in PyRIT's multi-turn Crescendo
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Weekly Red Team schedule (Mondays 2am UTC via EventBridge / Cloud Scheduler)
REDTEAM_SCHEDULE="0 2 * * 1"
# Optional webhook for Slack/Teams/Discord alerting on breached guardrails
REDTEAM_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"


# ------------------------------------------------------------------------------
# 3. Live Web Search Engines & External Knowledge
# ------------------------------------------------------------------------------
# Tavily Search API (Real-time fact retrieval for SearchAgent)
# Get your free key from https://tavily.com
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# Serper Google Search API (Alternative live web search)
# Get your key from https://serper.dev
SERPER_API_KEY="your_serper_api_key_here"

# Hugging Face Access Token (For downloading private/gated sentence transformers)
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_huggingface_access_token_here"


# ------------------------------------------------------------------------------
# 4. Security & Guardrails (AWS Bedrock & API Authentication)
# ------------------------------------------------------------------------------
# Internal Application API Key for authenticating clients (X-API-Key header)
API_KEY="secret-api-key-change-in-production"

# AWS Bedrock Guardrails (Dual-Layer AI Defense)
BEDROCK_GUARDRAIL_ID="default-guardrail"
BEDROCK_GUARDRAIL_VERSION="1"

# AWS Region & Credentials (Optional if running on ECS/GKE with IAM Roles)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
SECRETS_NAME="hybrid-anime-recommender/config"


# ------------------------------------------------------------------------------
# 5. Database & Caching Services (Redis & PostgreSQL / pgvector)
# ------------------------------------------------------------------------------
# Redis Cache & Message Stream
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# PostgreSQL with pgvector (Long-Term Memory & Version Storage)
DATABASE_URL="postgresql://dbadmin:password@localhost:5432/animeresearchdb"
DB_POOL_MIN=2
DB_POOL_MAX=10


# ------------------------------------------------------------------------------
# 6. Comet ML Experiment Tracking
# ------------------------------------------------------------------------------
# Get your credentials from https://www.comet.com
COMET_API_KEY="your-comet-ml-api-key"
COMET_PROJECT_NAME="hybrid-anime-recommender"
COMET_WORKSPACE="your-comet-workspace"


# ------------------------------------------------------------------------------
# 7. Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT="your-gcp-project-id"
GCP_REGION="us-central1"
# Relative or absolute path to your GCP Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account-key.json"

# GCS Dataset Buckets
BUCKET_NAME="anime-recommender-your-gcp-project-id"
GCS_BUCKET_URI="gs://anime-recommender-your-gcp-project-id"
GCS_PUBLIC_URL="https://storage.googleapis.com/anime-recommender-your-gcp-project-id"

# Dedicated DVC Version Tracking Bucket
DVC_BUCKET_NAME="anime-recommender-dvc-your-gcp-project-id"
DVC_REMOTE_URL="gs://anime-recommender-dvc-your-gcp-project-id/dvc_store"

# GCP Service Account Details
SA_NAME="anime-recommender"
SA_EMAIL="anime-recommender@your-gcp-project-id.iam.gserviceaccount.com"

# Google Container Registry (GCR)
GCR_HOSTNAME="gcr.io"
GCR_IMAGE_NAME="gcr.io/your-gcp-project-id/hybrid-anime-recommender"


# ------------------------------------------------------------------------------
# 8. Server, Network & Pipeline Orchestration
# ------------------------------------------------------------------------------
PORT=5001
KUBEFLOW_HOST="http://localhost:8080"


# ------------------------------------------------------------------------------
# 9. Agent Fine-Tuning & Memory Parameters
# ------------------------------------------------------------------------------
CACHE_TTL=3600
CACHE_SIMILARITY_THRESHOLD=0.85

SESSION_TTL=1800
SESSION_MAX_MESSAGES=5
SESSION_CONTENT_TRUNCATE=500

LTM_DAYS=7
LTM_THRESHOLD=0.88
LTM_DIFF_THRESHOLD=0.70
LTM_DIFF_LIMIT=5
IVFFLAT_LISTS=100

STREAM_KEY="research:jobs"
CONSUMER_GROUP="workers"
RESULT_TTL=3600

AGENT_REPORT_TRUNCATE=3000
AGENT_MAX_ITERATIONS=2

EVAL_REPORT_TRUNCATE=1500
EVAL_COMMENT_TRUNCATE=300

LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60


# ------------------------------------------------------------------------------
# 10. Container & GitHub Registries (CI/CD Deployment)
# ------------------------------------------------------------------------------
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="ghp_your_github_token"
DOCKERHUB_USERNAME="your-dockerhub-username"
DOCKERHUB_TOKEN="dckr_pat_your_dockerhub_token"


# ------------------------------------------------------------------------------
# 11. Apache Kafka Streaming & Azure Event Hubs (Tri-Cloud Architecture)
# ------------------------------------------------------------------------------
# For local Kafka / Redpanda:
#   KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
#   KAFKA_SECURITY_PROTOCOL="PLAINTEXT"
#
# For Azure Event Hubs (Standard/Premium tier exposes native Kafka 1.0+ on port 9093):
#   KAFKA_BOOTSTRAP_SERVERS="hybrid-anime-kafka-xxxxxx.servicebus.windows.net:9093"
#   KAFKA_SECURITY_PROTOCOL="SASL_SSL"
#   KAFKA_SASL_MECHANISM="PLAIN"
#   KAFKA_SASL_USERNAME="$ConnectionString"
#   KAFKA_SASL_PASSWORD="Endpoint=sb://hybrid-anime-kafka-xxxxxx.servicebus.windows.net/;SharedAccessKeyName=kafka-client-policy;SharedAccessKey=..."
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"
KAFKA_SASL_MECHANISM="PLAIN"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# Kafka Topics
KAFKA_TOPIC_INTERACTIONS="anime-interactions-stream"
KAFKA_TOPIC_SECURITY_AUDIT="security-audit-stream"
KAFKA_TOPIC_AGENT_RESEARCH="agent-research-stream"
KAFKA_CONSUMER_GROUP="recommender-online-worker"

# Azure AI Content Safety (PyRIT Red-Team Evaluator)
AZURE_CONTENT_SAFETY_ENDPOINT="https://hybrid-anime-safety.cognitiveservices.azure.com/"
AZURE_CONTENT_SAFETY_KEY="your-azure-content-safety-key"

